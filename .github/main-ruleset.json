{
  "name": "main: PRs, tests, and Valkey performance",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "required_linear_history"},
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "Tests and offline CI", "integration_id": 15368},
          {"context": "Valkey performance gate", "integration_id": 15368},
          {"context": "Valkey 4-CPU performance gate", "integration_id": 15368},
          {"context": "verify", "integration_id": 15368},
          {"context": "build (amd64, ubuntu-24.04)", "integration_id": 15368},
          {"context": "build (arm64, ubuntu-24.04-arm)", "integration_id": 15368},
          {"context": "Build pinned TCP compatibility tools", "integration_id": 15368},
          {"context": "Tcl redis / string", "integration_id": 15368},
          {"context": "Tcl redis / incr", "integration_id": 15368},
          {"context": "Tcl redis / keyspace", "integration_id": 15368},
          {"context": "Tcl valkey / string", "integration_id": 15368},
          {"context": "Tcl valkey / incr", "integration_id": 15368},
          {"context": "Tcl valkey / keyspace", "integration_id": 15368},
          {"context": "read-only-self-tests", "integration_id": 15368}
        ]
      }
    }
  ]
}
