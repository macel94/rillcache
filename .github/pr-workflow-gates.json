{
  "schema_version": 1,
  "workflows": {
    "ci.yml": {
      "events": [
        "push",
        "pull_request",
        "workflow_dispatch"
      ],
      "jobs": {
        "verify": [
          "Tests and offline CI"
        ]
      },
      "non_pr_jobs": {}
    },
    "pr-quality.yml": {
      "events": [
        "pull_request",
        "workflow_dispatch"
      ],
      "jobs": {
        "benchmark": [
          "Valkey performance gate"
        ]
      },
      "non_pr_jobs": {}
    },
    "pr-multicpu-quality.yml": {
      "events": [
        "pull_request",
        "workflow_dispatch"
      ],
      "jobs": {
        "gate": [
          "Valkey 4-CPU performance gate"
        ]
      },
      "non_pr_jobs": {},
      "aux_jobs": {
        "context": "dependency",
        "build": "dependency",
        "benchmark": "dependency"
      }
    },
    "container.yml": {
      "events": [
        "push",
        "pull_request",
        "workflow_dispatch"
      ],
      "jobs": {
        "verify": [
          "verify"
        ],
        "build": [
          "build (amd64, ubuntu-24.04)",
          "build (arm64, ubuntu-24.04-arm)"
        ]
      },
      "non_pr_jobs": {
        "publish": "not-pull-request",
        "public-pull": "needs-publish"
      }
    },
    "upstream-compatibility.yml": {
      "events": [
        "pull_request",
        "workflow_dispatch"
      ],
      "jobs": {
        "build": [
          "Build pinned TCP compatibility tools"
        ],
        "suites": [
          "Tcl redis / string",
          "Tcl redis / incr",
          "Tcl redis / keyspace",
          "Tcl valkey / string",
          "Tcl valkey / incr",
          "Tcl valkey / keyspace"
        ]
      },
      "non_pr_jobs": {}
    },
    "pr-branch-updater.yml": {
      "events": [
        "pull_request",
        "push",
        "schedule",
        "workflow_dispatch",
        "workflow_run"
      ],
      "jobs": {
        "read-only-self-tests": [
          "read-only-self-tests"
        ]
      },
      "non_pr_jobs": {
        "reconcile": "not-pull-request"
      }
    },
    "benchmarks.yml": {
      "events": [
        "schedule",
        "workflow_dispatch"
      ],
      "jobs": {},
      "non_pr_reason": "Weekly Tuesday 08:17 UTC legacy Rust-generator comparison refreshes benchmarks/README.md through a protected report PR; manual dispatch remains available. Daily five-server comparison is separate. Report PRs receive all ordinary required checks."
    },
    "hotpaths.yml": {
      "events": [
        "workflow_dispatch"
      ],
      "jobs": {},
      "non_pr_reason": "Manual trusted-main profiling study, not an every-PR workload."
    },
    "copilot-auth-check.yml": {
      "events": [
        "workflow_dispatch"
      ],
      "jobs": {},
      "non_pr_reason": "Manual default-branch inference authentication probe, never a PR credential path."
    },
    "openwiki-pages.yml": {
      "events": [
        "push",
        "workflow_dispatch"
      ],
      "jobs": {},
      "non_pr_reason": "Publishes the generated OpenWiki visualizer to GitHub Pages on main; not a PR check."
    },
    "upstream-performance.yml": {
      "events": [
        "schedule",
        "workflow_dispatch"
      ],
      "jobs": {},
      "non_pr_reason": "Daily five-server comparisons, manual legacy study, same-job hosted reactor diagnostics, separate owned-process instrumented profiles and opt-in fixed-host screening; none substitutes for any mandatory PR performance gate."
    },
    "openwiki-freshness.yml": {
      "events": [
        "push",
        "schedule"
      ],
      "jobs": {},
      "non_pr_reason": "Checks Grounded Claim evidence against source on main pushes and weekly; opens/updates an issue when semantic wiki refresh is needed. OpenWiki Pages publishes the checked-in visualizer on main."
    }
  }
}
