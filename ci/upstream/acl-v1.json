        [
          "SET",
          "data:k",
          "one"
        ]
      ],
      "commands": [
        [
          "GET",
          "data:k"
        ],
        [
          "SET",
          "data:k",
          "two"
        ],
        [
          "DEL",
          "data:k"
        ]
      ],
      "expect": [
        "allow",
        "allow",
        "deny"
      ],
      "post": [
        [
          "GET",
          "data:k"
        ]
      ],
      "post_expect": [
        [
          "bulk",
          "two"
        ]
      ]
    },
    {
      "id": "later-command-denial-wins",
      "acl": [
        "on",
        ">matrix-matrix-secret",
        "~data:*",
        "+@write",
        "-set"
      ],
      "seed": [
        [
          "SET",
          "data:k",
          "one"
        ]
      ],
      "commands": [
        [
          "SET",
          "data:k",
          "two"
        ],
        [
          "DEL",
          "data:gone"
        ],
        [
          "SET",
          "data:three",
          "x"
        ]
      ],
      "expect": [
        "deny",
        "allow",
        "deny"
      ],
      "post": [
        [
          "GET",
          "data:k"
        ]
      ],
      "post_expect": [
        [
          "bulk",
          "one"
        ]
      ],
      "isolated": "ordering keeps the earlier grant but the later denial wins for SET"
    },
    {
      "id": "subcommand-selector",
      "acl": [
        "on",
        ">matrix-matrix-secret",
        "~*",
        "+@connection",
        "+client",
        "-client|list",
        "-client|kill"
      ],
      "commands": [
        [
          "CLIENT",
          "GETNAME"
        ],
        [
          "CLIENT",
          "LIST"
        ],
        [
          "CLIENT",
          "KILL",
          "999999"
        ]
      ],
      "expect": [
        "allow",
        "deny",
        "deny"
      ]
    },
    {
      "id": "key-pattern-denied-mutation",
      "acl": [
        "on",
        ">matrix-matrix-secret",
        "~app:*",
        "+@all"
      ],
      "seed": [
        [
          "SET",
          "app:allowed",
