{
  "schema": 1,
  "matrix": {
    "id": "rillcache-acl-v1",
    "version": 1,
    "profile": "rillcache-standalone-0.1",
    "gap": "S2",
    "document": "docs/security.md",
    "claim": "Versioned allow/deny contract for the supported ACL subset on the exact tested head; not a full Redis ACL equivalence claim and not a security sign-off."
  },
  "admin": {
    "user": "admin",
    "password": "admin-matrix-secret"
  },
  "user": {
    "user": "matrix",
    "password": "matrix-matrix-secret"
  },
  "declared_divergences": [
    {
      "id": "keyspace-wide-needs-allkeys",
      "scenarios": [
        "keys-keyspace-wide-denied",
        "scan-keyspace-wide-denied",
        "flushdb-keyspace-wide-denied"
      ],
      "reason": "Rillcache requires an all-key grant for keyless keyspace-wide commands (KEYS, SCAN, RANDOMKEY, DBSIZE, FLUSHDB, FLUSHALL); pinned Redis and Valkey do not filter these by key patterns. The candidate denies with 'NOPERM keyspace-wide commands require an all-key ACL grant with the required access' so a scoped user cannot enumerate or flush outside its patterns. Documented in docs/security.md."
    },
    {
      "id": "dryrun-denial-class",
      "scenarios": [
        "acl-dryrun-parity"
      ],
      "reason": "For a denied command ACL DRYRUN returns the NOPERM error on the candidate, while pinned Redis and Valkey return a non-error textual result. The candidate's error is the stricter, machine-checkable signal and is documented in docs/security.md; the reference replies are retained in result.json."
    }
  ],
  "scenarios": [
    {
      "id": "category-read-write-split",
      "acl": [
        "on",
        ">matrix-matrix-secret",
        "~data:*",
        "+@read",
        "-@write"
      ],
      "seed": [
        [
          "SET",
          "data:k",
          "v"
        ]
      ],
      "commands": [
        [
          "GET",
          "data:k"
        ],
        [
          "SET",
          "data:k",
          "changed"
        ],
        [
          "DEL",
          "data:k"
        ]
      ],
      "expect": [
        "allow",
        "deny",
        "deny"
      ],
      "post": [
        [
          "GET",
          "data:k"
        ]
      ],
      "post_expect": [
        [
          "bulk",
          "v"
        ]
      ],
      "isolated": "a denied write leaves the permitted value unchanged"
    },
    {
      "id": "explicit-command-grants",
      "acl": [
