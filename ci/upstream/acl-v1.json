      ],
      "commands": [
        [
          "SET",
          "app:allowed",
          "updated"
        ],
        [
          "SET",
          "other:denied",
          "no"
        ],
        [
          "GET",
          "other:denied"
        ]
      ],
      "expect": [
        "allow",
        "deny",
        "deny"
      ],
      "post": [
        [
          "GET",
          "app:allowed"
        ],
        [
          "EXISTS",
          "other:denied"
        ]
      ],
      "post_expect": [
        [
          "bulk",
          "updated"
        ],
        [
          "int",
          0
        ]
